        <mxCell id="pmu" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=18;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=2;fontSize=14;fontColor=#14532d;shadow=1;arcSize=0;" value="&lt;b style=&quot;font-size:18px&quot;&gt;SPMU-857G / PMU&lt;/b&gt;&lt;br&gt;&lt;br&gt;PMU IDCODE：&lt;b&gt;0GZ00PN1&lt;/b&gt;&lt;br&gt;CFG 站名：000000中中中恒变&lt;br&gt;3号网口 IP：&lt;b&gt;12.100.100.20&lt;/b&gt;&lt;br&gt;4号网口 IP：&lt;b&gt;13.100.100.20&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;(直连主站使用4号及以后网口)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;管理 8001｜实时 8000｜离线 8600&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;获取配置信息：开启检修 Prate软件-操作-文件传输工具&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;config/cpu01/ 目录获取 hconfigcom.txt、pconfigtab.txt 和 psetting.txt&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="345" x="70" y="215" as="geometry" />
