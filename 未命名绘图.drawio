        <mxCell id="pdc" parent="field-zone" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=18;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=3;fontSize=14;fontColor=#1e3a8a;shadow=1;arcSize=0;" value="&lt;b style=&quot;font-size:18px&quot;&gt;SPMU-858G / PDC&lt;/b&gt;&lt;br&gt;&lt;br&gt;PDC/控制 IDCODE：&lt;b&gt;0GZ00PN1&lt;/b&gt;&lt;br&gt;当前连接目标：&lt;b&gt;100.73.252.44&lt;/b&gt;&lt;br&gt;1号网口IP（管理程序/连主站）：10.100.100.6&lt;div&gt;3号网口IP（接PMU数据）：12.100.100.6&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;（和PMU上传数据3号网口同网段）&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="320" x="510" y="222.5" as="geometry" />
