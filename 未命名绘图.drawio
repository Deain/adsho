  <diagram id="configuration-evidence" name="02 配置与证据明细">
    <mxGraphModel dx="680" dy="766" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="detail-title" value="数据库当前配置与设备 XML 证据对照" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=27;fontStyle=1;fontColor=#0f172a;" parent="1" vertex="1">
          <mxGeometry x="250" y="30" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="active-card" value="&lt;b style=&quot;font-size:18px&quot;&gt;A. 当前活动 PDC 配置（current_pdc_config）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;width:100%;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td&gt;处理单元目标 IP&lt;/td&gt;&lt;td&gt;&lt;b&gt;100.73.252.44&lt;/b&gt;&lt;/td&gt;&lt;td&gt;设备侧主站身份 IP&lt;/td&gt;&lt;td&gt;&lt;b&gt;10.100.100.211&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;管理 / 实时 / 离线端口&lt;/td&gt;&lt;td&gt;&lt;b&gt;8001 / 8000 / 8600&lt;/b&gt;&lt;/td&gt;&lt;td&gt;协议 / 角色&lt;/td&gt;&lt;td&gt;&lt;b&gt;V3 / client&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;控制 IDCODE&lt;/td&gt;&lt;td&gt;&lt;b&gt;0GZ00PN1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;bind_ip&lt;/td&gt;&lt;td&gt;0.0.0.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;连接 / 首帧 / 空闲超时&lt;/td&gt;&lt;td&gt;30 / 30 / 30 秒&lt;/td&gt;&lt;td&gt;离线超时&lt;/td&gt;&lt;td&gt;60 秒&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;离线内容长度 / 速率&lt;/td&gt;&lt;td&gt;6116 / 100 CPS&lt;/td&gt;&lt;td&gt;来源 / 保存时间&lt;/td&gt;&lt;td&gt;MANUAL / 2026-08-16 22:44:36 +08&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=13;fontColor=#1e3a8a;" parent="1" vertex="1">
          <mxGeometry x="60" y="115" width="720" height="315" as="geometry" />
        </mxCell>
        <mxCell id="xml-card" value="&lt;b style=&quot;font-size:18px&quot;&gt;B. 数据库保留的 858G XML 证据（pdc_files）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;pmumcfg.xml（采集侧）&lt;/b&gt;&lt;br&gt;• DC/PDC IDCODE：0GZ00PN1&lt;br&gt;• 857G：IDCODE 0GZ00PN1&lt;br&gt;• 857G A/B 网：12.100.100.21 / 13.100.100.21&lt;br&gt;• 采集端口：8001 / 8000 / 8600&lt;br&gt;&lt;br&gt;&lt;b&gt;pmuscfg.xml（主站转发侧）&lt;/b&gt;&lt;br&gt;• 858G 原始 DC IP：10.100.100.6&lt;br&gt;• 主站 1：10.100.100.210（省调 A 网）&lt;br&gt;• 主站 2：10.100.100.211（省调 B 网）&lt;br&gt;• CFG 版本：03.73[rev=260522]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=13;fontColor=#14532d;" parent="1" vertex="1">
          <mxGeometry x="820" y="115" width="720" height="315" as="geometry" />
        </mxCell>
        <mxCell id="site-card" value="&lt;b style=&quot;font-size:18px&quot;&gt;C. 当前场站与 CFG 快照&lt;/b&gt;&lt;br&gt;&lt;br&gt;场站：000000中中中恒变（SITE-1）&lt;br&gt;PDC ID：0GZ00PN1&lt;br&gt;当前 PMU 数量：1&lt;br&gt;PMU ID / 名称：0GZ00PN1 / 0GZ00PN1&lt;br&gt;CFG 站名：000000中中中恒变&lt;br&gt;CFG 类型：CFG2｜报告率：100 帧/s｜标称频率：50 Hz&lt;br&gt;CFG 快照时间：2026-08-16 22:45:13 +08" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;fontSize=13;fontColor=#581c87;" parent="1" vertex="1">
          <mxGeometry x="60" y="475" width="720" height="245" as="geometry" />
        </mxCell>
        <mxCell id="interpretation-card" value="&lt;b style=&quot;font-size:18px&quot;&gt;D. 地址角色解释&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;100.73.252.44&lt;/b&gt;：平台实际主动连接的 858G 目标地址（当前生效）。&lt;br&gt;&lt;b&gt;10.100.100.211&lt;/b&gt;：858G 设备侧识别的平台主站身份，当前选择 B 网。&lt;br&gt;&lt;b&gt;10.100.100.210&lt;/b&gt;：XML 中的 A 网候选主站，当前未选。&lt;br&gt;&lt;b&gt;10.100.100.6&lt;/b&gt;：导入 XML 记录的 858G 原始 DC 地址，未作为当前 target_ip。&lt;br&gt;&lt;b&gt;12.100.100.21 / 13.100.100.21&lt;/b&gt;：858G 采集侧配置的 857G 双网地址。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;fontSize=13;fontColor=#7c2d12;" parent="1" vertex="1">
          <mxGeometry x="820" y="475" width="720" height="245" as="geometry" />
        </mxCell>
        <mxCell id="source-flow-1" value="导入后曾人工调整 / 保存为 MANUAL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="xml-card" target="active-card" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="source-flow-2" value="运行时读取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3b82f6;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" parent="1" source="active-card" target="site-card" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conclusion" value="&lt;b&gt;核对结论&lt;/b&gt;&lt;br&gt;当前生产通信应以数据库活动配置为准：平台连接 100.73.252.44:8001/8000/8600，设备侧主站身份使用 10.100.100.211。XML 地址用于解释设备原始组网与备用主站，不应覆盖当前活动 target_ip。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#ecfeff;strokeColor=#06b6d4;strokeWidth=2;fontSize=14;fontColor=#164e63;" parent="1" vertex="1">
          <mxGeometry x="180" y="770" width="1240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="risk" value="待现场复核：数据库和 XML 当前均把 858G/PDC 与唯一 857G/PMU 的 IDCODE 记录为 0GZ00PN1；若设备实际应区分控制 IDCODE 与 PMU IDCODE，需要结合 857G 本机配置或现场抓包确认。" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#991b1b;align=left;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="280" y="910" width="1040" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
