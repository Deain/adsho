        <mxCell id="_3NzTG2FohDg6ten8kHg-4" edge="1" parent="field-zone" source="_3NzTG2FohDg6ten8kHg-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;startFill=0;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#16a34a;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="pdc" value="">
