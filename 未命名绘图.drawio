        <mxCell id="app" parent="platform-zone" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=18;fillColor=#ede9fe;strokeColor=#8b5cf6;strokeWidth=3;fontSize=14;fontColor=#4c1d95;shadow=1;arcSize=0;" value="&lt;b style=&quot;font-size:18px&quot;&gt;主站/配置端/PMU 实时分析平台&lt;/b&gt;&lt;br&gt;&lt;br&gt;角色：WAMS 主站程序&lt;br&gt;连接模式：&lt;b&gt;client（主动连接）&lt;/b&gt;&lt;br&gt;主站身份1：&lt;b&gt;10.100.100.210&lt;/b&gt;&lt;br&gt;主站身份2：&lt;b&gt;10.100.100.211&lt;/b&gt;&lt;div&gt;&lt;b&gt;...&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="345" x="80" y="222.5" as="geometry" />
